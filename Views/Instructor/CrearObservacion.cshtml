@model SistemaAprendices.Models.ObservacionAcademica

@{
    ViewData["Title"] = "Registrar Observación";
}

<div class="container mt-4">
    <h2>Registrar Observación Académica</h2>

    <form method="post">
        <input type="hidden" asp-for="AprendizId" />

        <div class="mb-3">
            <label>Tipo de Observación (Académica/Disciplinaria)</label>
            <select asp-for="Tipo" class="form-control">
                <option value="Academico">Académico</option>
                <option value="Disciplinario">Disciplinario</option>
            </select>
        </div>

        <div class="mb-3">
            <label>Detalle de la Observación</label>
            <textarea asp-for="Detalle" class="form-control" rows="4"></textarea>
        </div>

        <div class="mb-3">
            <label>Instructor Responsable</label>
            <input asp-for="InstructorResponsable" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">
            Guardar Observación
        </button>

        <a href="/Instructor/MisFichas" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>