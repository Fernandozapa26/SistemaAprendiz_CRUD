@model IEnumerable<SistemaAprendices.Models.ObservacionAcademica>

@{
    ViewData["Title"] = "Historial de Aprendiz";
}

<div class="container mt-4">
    <h2>Seguimiento Disciplinario y Académico</h2>

    <div class="list-group mt-3">
        @foreach (var obs in Model)
        {
            <div class="list-group-item">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">Tipo: @obs.Tipo</h5>
                    <small class="text-muted">@obs.Fecha.ToShortDateString()</small>
                </div>
                <p class="mb-1">@obs.Detalle</p>
                <small class="text-primary">Registrado por: @obs.InstructorResponsable</small>
            </div>
        }
    </div>

    <div class="mt-3">
        <a href="/Instructor/MisFichas" class="btn btn-secondary">Volver</a>
    </div>
</div>