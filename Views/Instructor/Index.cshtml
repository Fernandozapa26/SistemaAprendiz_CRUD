@model IEnumerable<SistemaAprendices.Models.Instructor>

<div class="container">
    <h2><i class="bi bi-person-badge"></i> Gestión de Instructores</h2>
    <table class="table table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Especialidad</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ins in Model)
            {
                <tr>
                    <td>@ins.Nombre @ins.Apellido</td>
                    <td>@ins.Especialidad</td>
                    <td class="text-center">
                        <a asp-action="VerFichasAsignadas" asp-route-id="@ins.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-journal-bookmark-fill"></i> Ver fichas
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>