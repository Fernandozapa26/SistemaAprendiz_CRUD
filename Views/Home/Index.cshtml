@{
    ViewData["Title"] = "Panel Principal";
}

<div class="container mt-4">

    <h1 class="text-center mb-4">Sistema de Gestión de Aprendices</h1>

    <div class="row g-4">

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>120</h3>
                    <p>Total Aprendices</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>15</h3>
                    <p>Instructores</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>32</h3>
                    <p>Observaciones</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h3>8</h3>
                    <p>Fichas Activas</p>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-5">
        <h4>Bienvenido al sistema institucional</h4>
        <p>
            Desde este panel podrá administrar aprendices,
            instructores, observaciones académicas y reportes.
        </p>
    </div>

</div>